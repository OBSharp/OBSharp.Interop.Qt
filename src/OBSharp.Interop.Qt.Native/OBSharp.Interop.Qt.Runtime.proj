<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OBSharp.Interop.Qt.runtimes.$(RuntimePackageRid)</PackageId>
    <Description>Native runtime assets for OBSharp.Interop.Qt on $(RuntimePackageRid).</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeAssetPath)' != ''">
    <RuntimeNativeAsset Include="$(NativeAssetPath)/**/*" />
    <None Include="@(RuntimeNativeAsset)"
          Pack="true"
          PackagePath="runtimes/$(RuntimePackageRid)/native/%(RecursiveDir)" />
  </ItemGroup>

  <Target Name="ValidateRuntimePackageInputs" BeforeTargets="Pack">
    <Error Condition="'$(RuntimePackageRid)' == ''"
           Text="RuntimePackageRid must be set to a supported RID." />
    <Error Condition="'$(NativeAssetPath)' == '' or !Exists('$(NativeAssetPath)')"
           Text="NativeAssetPath must point to the installed native library directory." />
    <Error Condition="'@(RuntimeNativeAsset)' == ''"
           Text="No native assets were found under '$(NativeAssetPath)'." />
  </Target>
</Project>
